# Telegram
TELEGRAM_BOT_TOKEN=
# Числовой chat id получателя отчётов (бот отвечает на /myid). Пусто — отчёты выключены.
TELEGRAM_REPORT_CHAT_ID=

# Адрес API для бота. В docker-compose переопределяется на http://api:8000
API_BASE_URL=http://127.0.0.1:8000
# Публичный адрес веб-кабинета для ссылок в отчётах. Для не-localhost обязателен https://
WEB_BASE_URL=https://hr.example.com

# Вход в веб-кабинет (HTTP Basic). Хеш argon2id, см. DEPLOY.md
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH=''
# Ключ, которым бот авторизуется в API (заголовок X-Bot-Key)
BOT_API_KEY=''

# Сейчас в коде не используются, оставлены на будущее
SESSION_SECRET=''
WEB_API_KEY=''

# OpenAI — генерация черновиков вакансий
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
